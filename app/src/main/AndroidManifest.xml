<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Runtime-requested on API 33+ (MainActivity); a no-op permission below that, where
         notifications don't need explicit user consent. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Placement Accountability Alarm. SCHEDULE_EXACT_ALARM (not USE_EXACT_ALARM): the
         latter is reserved by Play policy for apps whose core function IS alarms/calendaring,
         which this app is not (it is a placement-prep app with an alarm feature). This one is
         user-grantable via Settings and revokable at any time; AlarmScheduler checks
         canScheduleExactAlarms() before every schedule call, never assumes it stays granted. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- AlarmManager registrations do not survive reboot; BootRescheduleReceiver re-arms
         every enabled alarm once the app can run again after boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- PlacementAlarmService's actual technical work is looping an alarm tone via
         MediaPlayer, matching this type's own definition. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 14+ treats this as a special-access permission auto-granted only to apps
         whose core function is alarms/calling, which this app's is not. PlacementAlarmService
         checks NotificationManagerCompat.canUseFullScreenIntent() and degrades to a
         heads-up notification if it is not granted: lock-screen wake is best-effort here,
         not guaranteed, consistent with the rest of this feature's stated caveats. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Removed, not requested. Firebase Analytics (play-services-measurement) injects
         these three into the merged manifest automatically, and all three were shipping in
         the release APK. Confirmed with `aapt2 dump badging` against the built artifact, then
         traced to the injecting library in the manifest-merger report; not assumed.

         This app shows no advertising and runs no install-attribution campaigns, so it has no
         use for the advertising ID. Leaving the permissions in place is not neutral: Play
         Console's Data Safety form asks whether the app collects the advertising ID, and a
         manifest declaring AD_ID while the form says "no" is a mismatch Google can reject or
         take enforcement action over. The audience here is students, some of whom will be
         minors, which raises the bar further under the Families policy.

         Analytics itself keeps working; only advertising-ID-based attribution is given up. If
         advertising or paid install attribution is ever introduced, delete these three
         entries and declare the advertising ID in the Data Safety form in the same change. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />

    <!-- android:usesCleartextTraffic is set per product flavor (app/src/dev and
         app/src/prod), not here: dev talks to a plain-HTTP local/LAN backend
         (10.0.2.2 or a LAN IP), production must never allow cleartext. See
         README, "HTTPS / network security". -->
    <application
        android:name=".AiPlacementApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AiPlacementOs">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AiPlacementOs">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.AppFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Placement Accountability Alarm: standalone cold-start entry point, deliberately
             not part of MainActivity's nav graph (see PlacementAlarmChallengeActivity's own
             doc comment). showWhenLocked/turnScreenOn pair with the notification's
             setFullScreenIntent for lock-screen wake; both best-effort, not guaranteed on
             every OEM/Android version. -->
        <activity
            android:name=".alarm.PlacementAlarmChallengeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.AiPlacementOs" />

        <service
            android:name=".alarm.PlacementAlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver android:name=".alarm.AlarmFiredReceiver" android:exported="false" />

        <receiver android:name=".alarm.BootRescheduleReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
