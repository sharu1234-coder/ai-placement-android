# Copy to keystore.properties (gitignored -- never commit the real file) and fill in with
# your real release keystore details. If you don't have a release keystore yet, generate
# one first (keep it somewhere safe outside version control -- losing it means you can
# never publish an update to an app already on the Play Store under the old key):
#
#   keytool -genkeypair -v -keystore release.keystore -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the project root.
storeFile=../release.keystore
storePassword=changeme
keyAlias=changeme
keyPassword=changeme
